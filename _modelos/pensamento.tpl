$-- Um pensamento; it: um item de pensamentos em _dados/conteudo.lua (o
$-- gerar.lua acrescenta data-br). Usado num laço: sem linha de comentário
$-- no final.
<article class="cartao pensamento">
    <p class="periodo"><time datetime="${it.data}">${it.data-br}</time></p>
    <h2>${it.titulo}</h2>
    <p>${it.texto}</p>
</article>
